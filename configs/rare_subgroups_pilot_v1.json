    "seed_allocation": "categorical",
    "partner_pool": "all_other_members_of_same_cluster",
    "interpolation_lambda_uniform": [0.0, 1.0],
    "interpolation_upper_endpoint_exclusive": true,
    "generated_count": 900,
    "generated_count_reference": "original_fitting_class_counts_before_cleaning",
    "remove_final_minority_count": "100 - removed_originals + 900",
    "retention_control": "same_synthetic_rows_as_AW_REMOVE_restore_originals_not_extra_seeds",
    "unsupported_conditions": ["no_valid_cluster", "nonpositive_epsilon", "invalid_quota", "requested_generation_count_not_met"],
    "silent_fallback": false
  },
  "aw_tuning": {
    "min_samples_grid": [2, 3, 5],
    "epsilon_percentile_grid": [50, 65, 80],
    "objective": "aggregate_selection_positive_class_average_precision",
    "tie_break": "prefer_default_then_ascending_min_samples_then_percentile",
    "reuse_default_fit": true,
    "refit_after_selection": false,
    "test_unselected_candidates": false
  },
  "threshold": {
