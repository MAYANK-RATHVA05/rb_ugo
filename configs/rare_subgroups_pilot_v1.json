  "budget": {"settings": 6, "paired_cases": 30, "fixed_methods": 6, "aw_grid_candidates": 9, "extra_grid_fits_after_default_reuse": 8, "max_classifier_fits": 420, "planned_report_rows": 210},
  "screening_rules": {
