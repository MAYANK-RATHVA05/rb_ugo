    "training_label_corruption": false,
    "fit_counts": {"majority": 1000, "total_minority": 100, "rare_grid": [4, 8, 16], "common": "100 - n_rare"},
    "selection_counts": {"majority": 2000, "common": 180, "rare": 20},
    "calibration_counts": {"majority": 2000, "common": 0, "rare": 0},
    "test_counts": {"majority": 20000, "common": 1800, "rare": 200},
    "partition_ids": {"fitting": 1, "selection": 2, "calibration": 3, "test": 4},
    "component_ids": {"majority": 0, "common": 1, "rare": 2, "shuffle": 99},
    "rng": "default_rng(SeedSequence([seed, partition_id, component_id]))",
    "paired_draws": "Share standard-normal component pools across settings within a seed; take fitting prefixes and scale rare draws",
    "fitting_pool_sizes": {"common": 100, "rare": 16},
    "group_ids": "evaluator_only_never_model_sampler_or_selection_input"
  },
  "preprocessing": {"scaler": "StandardScaler", "fit_on": "original_fitting_X_only"},
  "classifier": {
    "class": "RandomForestClassifier",
    "n_estimators": 100,
    "criterion": "gini",
    "max_depth": null,
    "min_samples_split": 2,
    "min_samples_leaf": 1,
    "max_features": 1.0,
    "bootstrap": true,
    "n_jobs": 1,
    "random_state": "replicate_seed",
    "class_weight": null,
    "version_source": "requirements.txt"
  },
  "methods": ["NORES", "WEIGHTED", "ROS", "SMOTE", "AW_REMOVE", "AW_SEED_FILTER_RETAIN", "AW_REMOVE_TUNED"],
  "weighted_control_class_weight": "balanced",
  "smote_k_neighbors": 5,
  "sampler_random_state": "replicate_seed_in_fresh_instance",
  "aw_conventions": {
    "name": "AW-paper-conventions",
    "fidelity": "paper_based_with_declared_gap_resolutions_not_exact_verified_reproduction",
    "minority_label": 1,
    "boundary_k_other_rows": 5,
    "epsilon_k_other_minority_rows": 5,
    "epsilon_percentile": 65,
    "percentile_method": "linear",
    "dbscan_min_samples": 2,
    "dbscan_algorithm": "brute",
    "metric": "euclidean",
    "exclude_query_by": "row_index",
    "boundary_ties": "distance_then_original_fitting_row_id",
    "cluster_weight": "maximum_majority_neighbor_count",
    "all_cluster_weights_zero": "uniform_across_valid_clusters",
    "within_cluster_boundary_sum_zero": "uniform_within_cluster",
    "density_delta": 1e-8,
    "theta": 0.2,
    "gamma": 5,
    "quota_rounding": "floor(normalized_weight*N + 0.5)",
