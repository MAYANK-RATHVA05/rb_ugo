  "before_execution": ["implement_independent_cited_AW_baseline", "pass_meaningful_correctness_checks", "validate_training_only_preprocessing_and_hidden_group_isolation", "freeze_runner_and_configuration_commit", "obtain_next_stage_authorization"],
  "deferred": ["author_KeepNoise_and_SoftNoise_reconstructions", "actual_label_contamination", "additional_classifiers", "real_datasets", "new_sampler", "novelty_or_efficacy_claims"]
